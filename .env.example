# Supermemory API key from https://console.supermemory.ai
SUPERMEMORY_API_KEY=
# Photon Spectrum project credentials (Photon dashboard → project Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Signing secret of the Spectrum webhook that points at https://<deployment>/eve/v1/photon
SPECTRUM_WEBHOOK_SECRET=
# Comma-separated iMessage handles allowed to talk to the assistant (phone numbers or emails)
FRIEND_IMESSAGE_HANDLES=
# Optional: AI Gateway model id (default google/gemini-2.5-flash)
FRIEND_MODEL=
# Optional: the iMessage thread the check-in schedule sends to, printed in the logs on the first accepted message
FRIEND_CHECKIN_THREAD_ID=
# Local development only: Vercel AI Gateway key (on Vercel the deployment uses OIDC instead)
AI_GATEWAY_API_KEY=
